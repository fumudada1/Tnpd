
@using MvcPaging
@using Tnpd.Helpers
@model MvcPaging.IPagedList<TnpdModels.SystemLog>

@{
    ViewBag.Title = "網站稽核系統(LOG)";
}

<h2>網站稽核系統(LOG)</h2>
<div >

    <a href="/Syslog/Report" style="display: block; text-align:right;">匯出報表</a>
</div>


    @using (Html.BeginForm())
{
    <div>
       姓名/帳號：@Html.InputSearchBox("SearchByPoster", ViewData["SearchByPoster"])
        @Html.DisplayNameFor(model => model.FirstOrDefault().Subject)：@Html.InputSearchBox("SearchBySubject", ViewData["SearchBySubject"])<br/>
        @Html.DisplayNameFor(model => model.FirstOrDefault().Org)：@Html.DropDownList("SearchByOrgs", (IEnumerable<SelectListItem>)ViewBag.Orgs, "請選擇") <br/>
        @Html.DisplayNameFor(model => model.FirstOrDefault().Enent): @Html.DropDownList("SearchByEvent", new SelectList(Enum.GetValues(typeof(TnpdModels.SystemLogEvent))), "請選擇")
        @Html.DisplayNameFor(model => model.FirstOrDefault().attr): @Html.DropDownList("SearchByattr", new SelectList(Enum.GetValues(typeof(TnpdModels.SystemLogAttr))), "請選擇")<br/>
        發布日期:<input type="text" name="SearchByStartDate" value="@ViewData["SearchByStartDate"]" class="datepicker"/> ~ <input type="text" name="SearchByEndDate" value="@ViewData["SearchByEndDate"]" class="datepicker"/><br/>
    </div>
 <div>
        <input type="submit" value="搜尋" />
    </div>

    
}

<table class="table table-v">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.FirstOrDefault().Subject)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FirstOrDefault().Org)
        </th>
       
        <th>
            @Html.DisplayNameFor(model => model.FirstOrDefault().Enent)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FirstOrDefault().attr)
        </th>
        
        <th>
            帳號/姓名
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FirstOrDefault().InitDate)
        </th>
       
    </tr>
<tbody>
@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Subject)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Org)
        </td>
        
        <td>
            @Html.DisplayFor(modelItem => item.Enent)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.attr)
        </td>
        
        <td>
            @Html.DisplayFor(modelItem => item.Poster)
        </td>
        <td>
           @item.InitDate
        </td>
       
    </tr>
}
</tbody>
</table>

<div class="pager">
    @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount)
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    @Scripts.Render("~/bundles/jqueryui")
    @Styles.Render("~/Content/themes/base/css")
    <script>
        $(document).ready(function() {
            $(".datepicker").datepicker();

        });
    </script>
}

