@using TnpdModels
@model TnpdModels.CaseTraffic

@{
    ViewBag.Title = "案件查詢";
    string path = @"D:\website\tnpd\tnpdAdmin\TrafficFiles\";
    string assignUnit = Model.UnitFile == null ? Model.assignUnit.Subject : Model.UnitFile;
    string path1 = @"Z:\" + assignUnit + "\\" + @Model.InitDate.Value.ToString("yyyy-MM") + "\\" + @Model.CaseID + "\\";
    string path2 = @"X:\" + assignUnit + "\\" + @Model.InitDate.Value.ToString("yyyy-MM") + "\\" + @Model.CaseID + "\\";
 
   
}
@if (ViewBag.message != null)
{
    <script>
        alert("@ViewBag.message");
        window.location.href = "/CaseTraffics/Index";
    </script>
}
<h2>案件查詢</h2>

@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <fieldset>
    <legend>Case</legend>
        <input type="hidden" name="pclass" value="@ViewBag.pclass" />
    @Html.HiddenFor(model => model.Id)
    <span style="color: black">辦理情形</span>
    <table class="table table-v">

        <tbody>
        <tr>
            <td style="width: 50%">案號：@Model.CaseID
            </td>
            <td></td>
        </tr>
        <tr>
            <td>案件日期：@Model.InitDate
            </td>
            <td>
            </td>
        </tr>
        @if (Model.Poprocs.Count > 0)
        {
            <tr>
                <td>承辦單位：
                    @if(Model.Poprocs.FirstOrDefault().assignUnit!=null)
                    {
                      <span>@Model.Poprocs.FirstOrDefault().assignUnit.ParentUnit.Subject - @Model.Poprocs.FirstOrDefault().assignUnit.Subject</span> 
                    }else{
                    <span>@Model.assignUnit.Subject </span> 
                    }
                    
                </td>
                <td>承辦人：
                    @if (Model.Poprocs.FirstOrDefault().assignMember != null) 
                    {
                    <span>@Model.Poprocs.FirstOrDefault().assignMember.Name</span>
                    }
                    
                </td>
            </tr>
        }
        <tr>
            <td>預結案日：@Model.Predate
            </td>
            @if (Model.Poprocs.Count > 0)
            {
                <td>案件狀態：@Model.Poprocs.FirstOrDefault().Status
                </td>
            }
            else
            {
                <td>案件狀態：未分派
                </td>
            }
        </tr>
        </tbody>
    </table>
    <span style="color: black">處理紀錄</span>
    <table class="table table-v">
        <thead>
        <tr>
            <th>日期</th>
            <th>承辦單位</th>
            <th>承辦人</th>
            <th>作業</th>
        </tr>
        </thead>
        <tbody>
        @foreach (CaseTrafficPoprocLog log in Model.PoprocslLogs)
        {
            <tr>
                <td>
                    @log.InitDate
                </td>
                @if (log.assignUnit != null)
                {
                    <td>
                        @log.assignUnit.ParentUnit.Subject - @log.assignUnit.Subject
                    </td>
                }
                else
                {
                    <td>
                       
                    </td>
                }
                <td>
                    @log.assignMember.Name
                </td>
                <td>
                    @log.Action
                </td>

            </tr>
        }
            

        </tbody>
    </table>
    <span style="color: black">案件資料</span>

    <table class="table table-v">

        <tbody>
        <tr>
            <td>姓名：@Model.Name
                <input type="hidden" id="hidFromID" value="@Model.Pid"/>
                <input type="hidden" id="hidFromName" value="@Model.Name"/>
                <br />
                <span id="checkMessage" style="color: red"></span>
            </td>
            <td>@*性別：@Model.Gender*@</td>

        </tr>
        <tr>

            <td colspan="2">身分證字號：@Model.Pid</td>

        </tr>
        <tr>

            <td>電話：@Model.TEL</td>
            <td>職業：@Model.Job</td>
        </tr>
        <tr>

            <td colspan="2">E-mail：@Model.Email</td>

        </tr>
        <tr>

            <td colspan="2">地址：@Model.Address</td>

        </tr>
        <tr>

            <td colspan="2">主題：@Model.Subject</td>
           
        </tr>
        <tr>

            <td colspan="2">違規地點：@Model.violation_place_area @Model.violation_place_road @Model.violation_place</td>
        </tr>
        <tr>

            <td colspan="2">違規時間：@Model.violation_date.ToString("yyyy/MM/dd")  @Model.violation_time</td>
        </tr>
        <tr>

            <td>違規車號：@Model.violation_carno</td>
            <td>違規事項：@Model.itemno</td>
        </tr>
        <tr>

            <td colspan="2">內容：<br />
                @Html.Raw(UIUtility.Txt2Html(Model.Content))
            </td>

        </tr>
        <tr>

            <td colspan="2">上傳附件檔1：<br />
                @if (!string.IsNullOrEmpty(Model.Upfile1))
                {
                    <a href="https://trmgt.tnpd.gov.tw/TrafficFiles/@Model.Upfile1" target="_black">@Model.Upfile1</a> <span>或</span> 
                     <a href="https://trmgt.tnpd.gov.tw/TrafficFiles2/@assignUnit/@Model.InitDate.Value.ToString("yyyy-MM")/@Model.CaseID/@Model.Upfile1" target="_black">@Model.Upfile1</a> <span>或</span>
                     <a href="https://trmgt.tnpd.gov.tw/TrafficFiles3/@assignUnit/@Model.InitDate.Value.ToString("yyyy-MM")/@Model.CaseID/@Model.Upfile1" target="_black">@Model.Upfile1</a>
				
                   
                    <br />
                }
                @if (!string.IsNullOrEmpty(Model.Upfile2))
                {
                     <a href="https://trmgt.tnpd.gov.tw/TrafficFiles/@Model.Upfile2" target="_black">@Model.Upfile2</a> <span>或</span>
                    <a href="https://trmgt.tnpd.gov.tw/TrafficFiles2/@assignUnit/@Model.InitDate.Value.ToString("yyyy-MM")/@Model.CaseID/@Model.Upfile2" target="_black">@Model.Upfile2</a> <span>或</span>
                    <a href="https://trmgt.tnpd.gov.tw/TrafficFiles3/@assignUnit/@Model.InitDate.Value.ToString("yyyy-MM")/@Model.CaseID/@Model.Upfile2" target="_black">@Model.Upfile2</a>
                    
                    <br />

                }
                @if (!string.IsNullOrEmpty(Model.Upfile3))
                {
                     <a href="https://trmgt.tnpd.gov.tw/TrafficFiles/@Model.Upfile3" target="_black">@Model.Upfile3</a> <span>或</span>
                    <a href="https://trmgt.tnpd.gov.tw/TrafficFiles2/@assignUnit/@Model.InitDate.Value.ToString("yyyy-MM")/@Model.CaseID/@Model.Upfile3" target="_black">@Model.Upfile3</a> <span>或</span>
                    <a href="https://trmgt.tnpd.gov.tw/TrafficFiles3/@assignUnit/@Model.InitDate.Value.ToString("yyyy-MM")/@Model.CaseID/@Model.Upfile3" target="_black">@Model.Upfile3</a>
                    
                    <br />
                }
                @if (!string.IsNullOrEmpty(Model.Upfile4))
                {
                       <a href="https://trmgt.tnpd.gov.tw/TrafficFiles/@Model.Upfile4" target="_black">@Model.Upfile4</a> <span>或</span>
                       <a href="https://trmgt.tnpd.gov.tw/TrafficFiles2/@assignUnit/@Model.InitDate.Value.ToString("yyyy-MM")/@Model.CaseID/@Model.Upfile4" target="_black">@Model.Upfile4</a> <span>或</span>
                       <a href="https://trmgt.tnpd.gov.tw/TrafficFiles3/@assignUnit/@Model.InitDate.Value.ToString("yyyy-MM")/@Model.CaseID/@Model.Upfile4" target="_black">@Model.Upfile4</a>
                    <br />

                }
                @if (!string.IsNullOrEmpty(Model.Upfile5))
                {
                    <a href="https://trmgt.tnpd.gov.tw/TrafficFiles/@Model.Upfile5" target="_black">@Model.Upfile5</a> <span>或</span>
                     <a href="https://trmgt.tnpd.gov.tw/TrafficFiles2/@assignUnit/@Model.InitDate.Value.ToString("yyyy-MM")/@Model.CaseID/@Model.Upfile5" target="_black">@Model.Upfile5</a> <span>或</span>
                        <a href="https://trmgt.tnpd.gov.tw/TrafficFiles3/@assignUnit/@Model.InitDate.Value.ToString("yyyy-MM")/@Model.CaseID/@Model.Upfile5" target="_black">@Model.Upfile5</a>
                    
                    <br />
                }
                @if (!string.IsNullOrEmpty(Model.Upfile6))
                {
                    <a href="https://trmgt.tnpd.gov.tw/TrafficFiles/@Model.Upfile6" target="_black">@Model.Upfile6</a> <span>或</span>
                     <a href="https://trmgt.tnpd.gov.tw/TrafficFiles2/@assignUnit/@Model.InitDate.Value.ToString("yyyy-MM")/@Model.CaseID/@Model.Upfile6" target="_black">@Model.Upfile6</a> <span>或</span>
                     <a href="https://trmgt.tnpd.gov.tw/TrafficFiles3/@assignUnit/@Model.InitDate.Value.ToString("yyyy-MM")/@Model.CaseID/@Model.Upfile6" target="_black">@Model.Upfile6</a>
                    <br />
                    
                }
            </td>

        </tr>
     


        </tbody>
    </table>
@if (Model.Poprocs.Count > 0)
{
    <table class="table table-v">
       
       
        <tr>
            <td colspan="2">
                回覆附件：
                @if (!string.IsNullOrEmpty(Model.Poprocs.FirstOrDefault().Upfile1))
                {
                    <a href="/Casefiles/@Model.Poprocs.FirstOrDefault().Upfile1" target="_black">@Model.Poprocs.FirstOrDefault().Upfile1</a>
                }
                else
                {
                    <span>無上傳附件</span>
                }
               
            </td>
        </tr>
        <tr>
            <td colspan="2">
                回覆情形：
                @if (Model.Poprocs.FirstOrDefault().PoprocsType == 1)
                {
                    <span>不舉發</span>
                    <div>不舉發原因：@Model.Poprocs.FirstOrDefault().ViolationsRejectclass.Subject</div>
                    
                }
                else if (Model.Poprocs.FirstOrDefault().PoprocsType == 2)
                {
                    <span>舉發</span>
                    <div>舉發原因：@Model.Poprocs.FirstOrDefault().ViolationsClass.Subject</div>
                }
               
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div style="text-align: center">回覆內容</div>
                @Html.Raw(UIUtility.Txt2Html(Model.Poprocs.FirstOrDefault().AssignMemo))

            </td>
        </tr>

    </table>
}
  

        
    <div>
        
       
    </div>
    <p align="center">
        <input name="processtype" id="processtype" value="" type="hidden" />
        <input type="button" id="btnRestone" value="案件狀態回復" style="display: none"/>
        @if (Model.Poprocs.Count > 0 && Model.Poprocs.FirstOrDefault().Status == CaseProcessStatus.結案)
        {
            <input type="button" id="btnSendMail" value="寄送結案通知"/>
            
        }
        <div>
            <a href="/CaseTraffics/Print2/@Model.Id" target="_black">列印</a>|
            <a href="/CaseTraffics/Print2all/@Model.Id" target="_black">列印(含個資資料)</a>

        </div>
        <input type="button" onclick="history.back()" value="回到上一頁"/>
       
    </p>
    </fieldset>
}
<style>
    label {
        display: inline;
        font-size: 16px;
        font-weight: 600;
    }
</style>
   
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    @Scripts.Render("~/bundles/jqueryui")
    @Styles.Render("~/Content/themes/base/css")
    <script>
        $(document).ready(function () {
            $(".datepicker").datepicker();

            $("#btnRestone").click(function () {
                $("#processtype").val("Restone");
                
                $("form").submit();
                $("#btnRestone").attr("disabled", "disabled");
            });
            $("#btnSendMail").click(function () {
                $("#processtype").val("SendMail");
                $("form").submit();
                $("#btnSendMail").attr("disabled", "disabled");
            });
          

            if ($('#hidFromID').val() != '') {
                $('#checkMessage').text('檢查身份證字號中....');
                $.get("http://10.128.0.41:2080/Soap/checkId", { id: $('#hidFromID').val() })
                    .done(function (data) {
                        if (data == '查無資料') {
                            $('#checkMessage').text(data);
                            console.log(data);
                        } else {
                            var checkMessage;
                            if (data == $('#hidFromName').val()) {
                                checkMessage = '回傳名字為：' + data + ",比對結果：符合";
                            } else {
                                checkMessage = '回傳名字為：' + data + ",比對結果：不符合，請人工確認";
                            }
                            console.log(checkMessage);
                            $('#checkMessage').text(checkMessage);
                        }

                    });
            }

        });


    </script>
  
    

}


