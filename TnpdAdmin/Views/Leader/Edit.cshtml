
@using Tnpd.Models
@model TnpdModels.Leader

@{
    ViewBag.Title = "首長介紹編輯";
}

<h2>首長介紹編輯</h2>

    @using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" })) {

    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <fieldset>
        <legend>Leader</legend>

        @Html.HiddenFor(model => model.Id)

        <div class="editor-label">
            @Html.LabelFor(model => model.LeaderCatalogId)
        </div>
        <div class="editor-field">
            @Html.DropDownList("LeaderCatalogId")
            @Html.ValidationMessageFor(model => model.LeaderCatalogId)
           
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.Name)
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.Name,new { placeholder=ModelsAttributeHelper<TnpdModels.Leader>.GetDisplayName("Name") })
           
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.UpImage1)
        </div>
        <div class="editor-field">
            <input type="file" name="UpImage1" />
            @Html.HiddenFor(model => model.UpImage1)
            @if (!string.IsNullOrEmpty(Model.UpImage1))
            {
                <img src="~/upfiles/images/S@(Model.UpImage1)" />
            }
           
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.Education)
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.Education,new { placeholder=ModelsAttributeHelper<TnpdModels.Leader>.GetDisplayName("Education") })
           
        </div>
        
        <div class="editor-label">
            @Html.LabelFor(model => model.Experience)
        </div>
        <div class="editor-field">
            @Html.TextAreaFor(model => model.Experience,new { placeholder=ModelsAttributeHelper<TnpdModels.Leader>.GetDisplayName("Experience") })
           
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.ListNum)
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.ListNum,new { placeholder=ModelsAttributeHelper<TnpdModels.Leader>.GetDisplayName("ListNum") })
           
        </div>
            
            @Html.HiddenFor(model => model.Poster)
        @Html.HiddenFor(model => model.initOrg)
        @Html.HiddenFor(model => model.UpdateOrg)

            @Html.HiddenFor(model => model.InitDate)
        

            @Html.HiddenFor(model => model.UpdateDate)
        <p>
            <input type="submit" value="更新" /> <input type="button" onclick="history.back()" value="回到上一頁" />
        </p>
    </fieldset>
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <style>
        textarea {
            height: 150px;
        }
    </style>
}
