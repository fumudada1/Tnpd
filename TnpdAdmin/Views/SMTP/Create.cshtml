@using Tnpd.Models
@model TnpdModels.SMTPServerSetting

@{
    ViewBag.Title = "發信主機設定新增";
}

<h2>發信主機設定新增</h2>

    @using (Html.BeginForm()) {

    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)
    @ViewBag.Message
    <fieldset>
        <legend>SMTPServerSetting</legend>

        <div class="editor-label">
            @Html.LabelFor(model => model.Subject)

        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.Subject,new { placeholder=ModelsAttributeHelper<TnpdModels.SMTPServerSetting>.GetDisplayName("Subject") })
            @Html.ValidationMessageFor(model => model.Subject)
       
            
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.Address)

        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.Address,new { placeholder=ModelsAttributeHelper<TnpdModels.SMTPServerSetting>.GetDisplayName("Address") })
            @Html.ValidationMessageFor(model => model.Address)
       
            
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.MailAccount)

        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.MailAccount,new { placeholder=ModelsAttributeHelper<TnpdModels.SMTPServerSetting>.GetDisplayName("MailAccount") })
            @Html.ValidationMessageFor(model => model.MailAccount)
       
            
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.MailPassword)

        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.MailPassword,new { placeholder=ModelsAttributeHelper<TnpdModels.SMTPServerSetting>.GetDisplayName("MailPassword") })
            @Html.ValidationMessageFor(model => model.MailPassword)
       
            
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.Port)

        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.Port,new { placeholder=ModelsAttributeHelper<TnpdModels.SMTPServerSetting>.GetDisplayName("Port") })
            @Html.ValidationMessageFor(model => model.Port)
       
            
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.EnableSsl)

        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.EnableSsl,new { placeholder=ModelsAttributeHelper<TnpdModels.SMTPServerSetting>.GetDisplayName("EnableSsl") })
            @Html.ValidationMessageFor(model => model.EnableSsl)
       
            
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.UseDefaultCredentials)

        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.UseDefaultCredentials,new { placeholder=ModelsAttributeHelper<TnpdModels.SMTPServerSetting>.GetDisplayName("UseDefaultCredentials") })
            @Html.ValidationMessageFor(model => model.UseDefaultCredentials)
       
            
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.SmtpDeliveryMethod)

        </div>
        <div class="editor-field">
            @Html.DropDownListFor(model => model.SmtpDeliveryMethod, new SelectList(Enum.GetValues(typeof(System.Net.Mail.SmtpDeliveryMethod))))
            @Html.ValidationMessageFor(model => model.SmtpDeliveryMethod)
       
            
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.Enable)

        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.Enable,new { placeholder=ModelsAttributeHelper<TnpdModels.SMTPServerSetting>.GetDisplayName("Enable") })
            @Html.ValidationMessageFor(model => model.Enable)
       
            
        </div>



     

        <p>
            <input type="submit" value="新增" /><input type="button" onclick="history.back()" value="回到上一頁" />
        </p>
    </fieldset>
}



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")


}
