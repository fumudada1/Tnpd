@*<link href="~/Content/themes/base/jquery.ui.core.css" rel="stylesheet"/>
<link href="~/Content/themes/base/jquery.ui.datepicker.css" rel="stylesheet"/>
<link href="~/Content/themes/base/jquery.ui.theme.css" rel="stylesheet"/>*@
<script type="text/javascript">
    var smsVerified = false;
    var emailVerified = false;

    function goStep(n) {
        $('#step1,#step2,#step3').hide();
        $('#step' + n).show();
        $('#step-label-1,#step-label-2,#step-label-3').removeClass('step-active');
        $('#step-label-' + n).addClass('step-active');
    }

    $(document).ready(function () {
        // 送出後若有錯誤（驗證碼錯誤等），直接回到步驟三
        var _initStep = @((!ViewData.ModelState.IsValid || ViewBag.Message != null) ? 3 : 1);
        goStep(_initStep);
    });

    $('#TEL').on('input', function () { smsVerified = false; });
    $('#SMSCode').on('input', function () { smsVerified = false; });
    $('#Email').on('input', function () { emailVerified = false; });
    $('#EmailCode').on('input', function () { emailVerified = false; });

    $('#btn-prev2').click(function () { goStep(1); });
    $('#btn-prev3').click(function () { goStep(2); });

    $('#btn-next1').click(function () {
        var mobile = $('#TEL').val();
        var code = $('#SMSCode').val();
        if (!mobile) { $('#smsVerifyMsg').text('請填寫行動電話'); return; }
        if (!code) { $('#smsVerifyMsg').text('請填寫簡訊驗證碼'); return; }
        if (smsVerified) { goStep(2); return; }
        var $btn = $(this);
        $btn.prop('disabled', true).text('驗證中...');
        $.post('/ChiefMailbox/CheckSmsCode', { mobile: mobile, code: code })
            .done(function (data) {
                if (data.success) {
                    smsVerified = true;
                    $('#smsVerifyMsg').text('');
                    goStep(2);
                } else {
                    $('#smsVerifyMsg').text(data.message);
                }
            })
            .fail(function () { $('#smsVerifyMsg').text('連線失敗，請稍後再試。'); })
            .always(function () {
                $btn.prop('disabled', false).html('下一步 &rsaquo;');
            });
    });

    $('#btn-next2').click(function () {
        var email = $('#Email').val();
        var code = $('#EmailCode').val();
        if (!email) { $('#emailVerifyMsg').text('請填寫E-Mail'); return; }
        if (!code) { $('#emailVerifyMsg').text('請填寫E-Mail驗證碼'); return; }
        if (emailVerified) { goStep(3); return; }
        var $btn = $(this);
        $btn.prop('disabled', true).text('驗證中...');
        $.post('/ChiefMailbox/CheckEmailCode', { email: email, code: code })
            .done(function (data) {
                if (data.success) {
                    emailVerified = true;
                    $('#emailVerifyMsg').text('');
                    goStep(3);
                } else {
                    $('#emailVerifyMsg').text(data.message);
                }
            })
            .fail(function () { $('#emailVerifyMsg').text('連線失敗，請稍後再試。'); })
            .always(function () {
                $btn.prop('disabled', false).html('下一步 &rsaquo;');
            });
    });

    function PlayCode() {
        var name = ReadCookie("CheckCode");
        var url2 = "/wav/" + name + ".wav";

        if (/(MSIE|Trident\/|Edge\/)/i.test(navigator.userAgent)) {
            //本來這裡用的是<bgsound src="system.wav"/>,結果IE8不播放聲音,於是換成了embed
            $('#newMessageDIV').html("<embed src='" + url2 + "'/>");
        } else {
            //Firefox,Chrome均支持<audio/>
            $('#newMessageDIV').html("<audio autoplay='autoplay'><source src='" + url2 + "' type='audio/wav'/></audio>");
        }
    }
    $("#sendmail").click(function () {
        var email = $('#Email').val();
        $("#mailMessage").text('發送信件' + $('#Email').val());
        $.get("/ChiefMailbox/SendVerifyMailCode/", { id: $('#Email').val() })
            .done(function (data) {
                $("#mailMessage").text(data);
            });
    });

    function fleshVerify() {

        //重载验证码

        var time = new Date().getTime();

        document.getElementById('imgVerify').src = '/Captcha/CaptchaImage/' + time;

    }
    function ReadCookie(name) {
        var dc = document.cookie;
        var start1 = dc.indexOf(name + "=");
        if (start1 == -1) {
            return "";
        }
        else {
            start = dc.indexOf("=", start1) + 1;
            var end = dc.indexOf(";", start);
            if (end == -1) {
                end = dc.length;
            }
            var value = unescape(dc.substring(start, end));
            if (value == null) {
                return ""
            }
            else {
                return value;
            }
        }
    }
    
    var smsTimer;
    var t = 180;
    var smsAttempts = 0;
    var maxAttempts = 3;

    function showTime() {
        t -= 1;
        document.getElementById('smstime').innerHTML = "請留意手機簡訊，若一直沒有收到可在" + t + "秒後可再傳送一次。";
        if (t <= 0) {
            clearTimeout(smsTimer);
            if (smsAttempts < maxAttempts) {
                $("#sendSms").prop('disabled', false);
            } else {
                document.getElementById('smstime').innerHTML = "已達到最大發送次數。";
            }
        } else {
            smsTimer = setTimeout(showTime, 1000);
        }
    }

    $("#sendSms").click(function () {
        $("#smsMessage").text('');
        var Mobile = $('#TEL').val();
        if (!is_mobile(Mobile)) {
            $("#smsMessage").text('手機格式錯誤!');
            return;
        }
        if (smsAttempts >= maxAttempts) {
            $("#smsMessage").text('已達到最大發送次數。');
            return;
        }
        $("#sendSms").prop('disabled', true);
        smsAttempts++;
        t = 180;
        showTime();
        $("#smsMessage").text('發送簡訊至' + Mobile + '中，請稍後! (第' + smsAttempts + '次發送)');
        SendSMS(Mobile);
    });

    // 重置函数，用于在需要时重置发送次数
    function resetSmsAttempts() {
        smsAttempts = 0;
        clearTimeout(smsTimer);
        $("#sendSms").prop('disabled', false);
        document.getElementById('smstime').innerHTML = '';
    }
    function SendSMS(Mobile) {
        $.post("/ChiefMailbox/SendVerifyMobile", { mobile: Mobile, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() })
            .done(function (data) {
                if (data == '已經發送，請留意簡訊訊息!') {
                    $("#smsMessage").text(data);
                } else {
                    $("#smsMessage").text(data || '簡訊發送失敗，請稍後再試。');
                }
            })
            .fail(function () {
                $("#smsMessage").text('連線失敗，請稍後再試。');
            });
    }
    //訂單提交頁-驗證手機號
    function is_mobile(mobile) {
        if (mobile == "") {
            return false;
        } else {
            if (! /^(09([0-9]){8})$/.test(mobile)) {
                return false;
            }
            return true;
        }
    }
</script>
<style>
    .field-validation-error { color: red; }
    .wizard-steps { margin: 15px 0; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .step-badge { font-size: 0.95em; padding: 6px 12px; background-color: #6c757d; color: #fff; border-radius: 4px; display: inline-block; }
    .step-badge.step-active { background-color: #17a2b8; color: #fff; }
    .step-arrow { color: #6c757d; font-size: 1.3em; }
</style>
